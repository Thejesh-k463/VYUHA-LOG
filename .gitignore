# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Vendor licence ledger — contains buyer emails and the keys you issued.
# Never commit; back it up privately alongside license-private.pem.
license-ledger.jsonl

# Generated by scripts/build-landing.mjs — 300KB+ of inlined base64.
# Rebuild it, don't version it.
docs/sales/landing-page.standalone.html

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vyuha local database (never commit user data)
/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# playwright
/test-results/
/playwright-report/

# tauri desktop build artifacts
/desktop-dist/
/src-tauri/target/
/src-tauri/gen/

# Shareable client ZIPs are release artefacts, never repository content.
/release-packages/

# tauri updater signing key (vendor secret — never commit)
updater-private.key

# Tauri updater SIGNING KEY. Never commit — anyone holding it can sign an
# update that every installed copy of Vyuha will trust and install.
.secrets/
*.key
!*.key.pub

# Corrected release artefacts staged for manual upload — never version binaries.
/release-2.98.0-corrected/

# Un-redacted broker exports used as local test inputs. These are real
# statements: they carry account numbers and actual trade history, and this
# repo has a GitHub remote. Anything committed here is public forever, since
# deleting a file later does not remove it from git history. Redacted
# fixtures belong in tests/fixtures/ and are committed normally.
/tests/fixtures/private/

# Scratch file written by scripts/verify-release-signatures.mjs while decoding
# each .sig. The script removes it, but a crashed run must not leave a blob
# that the next `git add -A` commits (it did once, at v2.99.91).
/.sigcheck.tmp

# Trend artifact from npm run test:load — a measurement, not source.
/load-results.json

# Automated demo-video takes (regenerated per release by scripts/demo-video/record.mjs)
demo-takes/

# Downloaded exchange listing files for scripts/build-isin-symbols.mjs (regenerable)
/.isin-lists/
