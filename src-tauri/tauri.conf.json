{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vyuha",
  "version": "2.99.100",
  "identifier": "in.vyuha.tradejournal",
  "build": {
    "frontendDist": "./loading",
    "beforeBuildCommand": "npm run build && npm run desktop:bundle"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vyuha \u2014 Trade Journal",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGRjg1RjNCQkUxREEyMUQKUldRZG9oMitPMS80VHpNVEdTTy9kUVF5NlJ3dEh0aWloRXFXVW5ZY3FSdHlIcjNRSVVKMFBDbUsK",
      "endpoints": [
        "https://github.com/Thejesh-k463/VYUHA-LOG/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Local-first trade journal for Indian traders",
    "longDescription": "A fully local, offline trade journal and analytics cockpit for Indian retail traders. Exact broker-and-segment charge computation, MTF interest, discipline enforcement and ITR-ready tax schedules. No account, no cloud, no telemetry.",
    "copyright": "Copyright © Vyuha",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": true,
  "windows": {
    "nsis": {
      "installerHooks": "installer-hooks.nsh",
      "installerIcon": "icons/icon.ico",
      "headerImage": "installer-header.bmp",
      "sidebarImage": "installer-sidebar.bmp"
    }
  },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../desktop-dist": "server"
    }
  }
}
